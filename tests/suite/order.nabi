// Convergence orders of the adaptive methods, measured with the step
// pinned (`first_step = max_step = h`, tolerances so loose that every
// step passes) at h and h / 2.

use pkg::tests::suite::{expect, order_near};
use pkg::{Jacobian, Method};
use core::array::{Array, Matrix, Vector};

/// Logistic y' = y (1 - y), y(0) = 0.1: y = 1 / (1 + 9 e^-t).
fn logistic(t: f64) -> f64 { 1.0 / (1.0 + 9.0 * (-t).exp()) }

/// End error and the largest dense-output error at off-step points,
/// with the step pinned at `h` over 0..2.
fn pinned(m: Method, h: f64) -> (f64, f64) {
    let y0: Vector<f64> = [0.1];
    let r = try! pkg::solve_ivp(|t: f64, y: Vector<f64>| -> Vector<f64> { y .* (1.0 .- y) }, 0.0..2.0, y0, method: m, rtol: 1e3, atol: 1e3, first_step: h, max_step: h);
    let worst = 0.0;
    for i in 0..40 {
        let t = 0.05 * (i as f64) + 0.0137;
        worst = worst.max((r.sol.at(t)[0] - logistic(t)).abs());
    }
    let want = (2.0 / h).round() as usize;
    // Rounding in t may leave one sliver step at the end.
    expect(r.steps == want || r.steps == want + 1, f"{m:?} pinned at h = {h}: {r.steps} steps");
    ((r.last()[0] - logistic(2.0)).abs(), worst)
}

#[test]
fn explicit_orders() {
    let cases = [(Method::Rk23, 0.1, 3.0, 3.0), (Method::Rk45, 0.2, 5.0, 4.0), (Method::Dop853, 0.5, 8.0, 7.0)];
    for c in cases {
        let (m, h, p, pd) = c;
        let (e1, d1) = pinned(m, h);
        let (e2, d2) = pinned(m, 0.5 * h);
        order_near(e1, e2, p, 1.0, f"{m:?} solution");
        // The interpolant's local error is O(h^(pd + 1)); globally the
        // solution's O(h^p) adds, so the observed order is in pd..=p.
        order_near(d1, d2, pd, p - pd + 1.0, f"{m:?} dense output");
    }
}

/// y' = -2 y + cos t, y(0) = 1: y = (2 cos t + sin t) / 5 + 0.6 e^-2t.
fn linear(t: f64) -> f64 { (2.0 * t.cos() + t.sin()) / 5.0 + 0.6 * (-2.0 * t).exp() }

fn pinned_implicit(m: Method, h: f64) -> f64 {
    let y0: Vector<f64> = [1.0];
    let j: Matrix<f64> = [[-2.0]];
    let r = try! pkg::solve_ivp(|t: f64, y: Vector<f64>| -> Vector<f64> { [-2.0 * y[0] + t.cos()] }, 0.0..4.0, y0, method: m, rtol: 1e3, atol: 1e3, first_step: h, max_step: h, jac: Jacobian::Constant(j));
    let want = (4.0 / h).round() as usize;
    expect(r.steps == want || r.steps == want + 1, f"{m:?} pinned at h = {h}: {r.steps} steps");
    (r.last()[0] - linear(4.0)).abs()
}

#[test]
fn implicit_orders() {
    order_near(pinned_implicit(Method::Radau, 0.4), pinned_implicit(Method::Radau, 0.2), 5.0, 1.0, "Radau IIA");
    order_near(pinned_implicit(Method::Rodas, 0.4), pinned_implicit(Method::Rodas, 0.2), 4.0, 1.0, "Rodas");
}

#[test]
fn bdf_tolerance_proportionality() {
    // Variable order, so check that the error follows the tolerance.
    let y0: Vector<f64> = [1.0];
    let errs: List<f64> = [];
    for tol in [1e-4, 1e-6, 1e-8] {
        let r = try! pkg::solve_ivp(|t: f64, y: Vector<f64>| -> Vector<f64> { [-2.0 * y[0] + t.cos()] }, 0.0..4.0, y0, method: Method::Bdf, rtol: tol, atol: tol);
        errs.push((r.last()[0] - linear(4.0)).abs());
    }
    expect(errs[0] < 1e-3 && errs[1] < errs[0] / 10.0 && errs[2] < errs[1] / 10.0, f"BDF error follows rtol: {errs:?}");
}

#[test]
fn work_falls_with_order() {
    // At a tight tolerance the higher-order pairs take far fewer steps.
    let y0: Vector<f64> = [0.1];
    let n: List<usize> = [];
    for m in [Method::Rk23, Method::Rk45, Method::Dop853] {
        let r = try! pkg::solve_ivp(|t: f64, y: Vector<f64>| -> Vector<f64> { y .* (1.0 .- y) }, 0.0..10.0, y0, method: m, rtol: 1e-10, atol: 1e-12);
        n.push(r.nfev);
    }
    expect(n[0] > 3 * n[1] && n[1] > n[2], f"evaluations RK23, RK45, DOP853: {n:?}");
}
