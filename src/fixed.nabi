// Classical one-step methods on a uniform grid: no error control, the
// cost known in advance (`stages x steps` evaluations), and a global
// error that falls as `h^order`. Dense output is the cubic Hermite
// interpolant through the nodes and their derivatives (one more
// evaluation at the end), accurate to O(h^4) or the method's order,
// whichever is lower.

use pkg::dense::{Dense, Piece};
use pkg::{OdeError, Solution, Status};
use core::array::{Array, Vector};
use core::range::Range;
use linalg::AsVector;

/// A fixed-step method for `fixed`.
///
/// | method     | order | stages |
/// |------------|-------|--------|
/// | `Euler`    | 1     | 1      |
/// | `Midpoint` | 2     | 2      |
/// | `Heun`     | 2     | 2      |
/// | `Rk4`      | 4     | 4      |
///
/// ```nabi
/// use ode::Fixed;
///
/// assert(Fixed::Rk4.order() == 4 && Fixed::Euler.order() == 1);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub enum Fixed {
    /// Forward Euler.
    Euler,
    /// The explicit midpoint rule.
    Midpoint,
    /// Heun's method (explicit trapezoid).
    Heun,
    /// The classical 4th order Runge-Kutta method.
    Rk4,
}

impl Fixed {
    /// The order of accuracy.
    ///
    /// ```nabi
    /// assert(ode::Fixed::Heun.order() == 2);
    /// ```
    pub fn order(self) -> usize {
        match self {
            Fixed::Euler => 1,
            Fixed::Midpoint => 2,
            Fixed::Heun => 2,
            Fixed::Rk4 => 4,
        }
    }
}

fn axpy(y: List<f64>, w: f64, k: List<f64>) -> List<f64> {
    let r = y.clone();
    for m in 0..r.len() { r[m] += w * k[m]; }
    r
}

fn call(f: fn(f64, Vector<f64>) -> Vector<f64>, t: f64, y: List<f64>, ref nfev: usize) throws (OdeError) -> List<f64> {
    nfev += 1;
    let n = y.len();
    let v = f(t, Array::view_list(y, [n]));
    if v.len() != n {
        throw OdeError::LengthMismatch { what: f"f(t, y) returned {v.len()} values for {n} unknowns; return one derivative per component of y" };
    }
    match v.as_list() {
        xs: List<f64> => xs,
        none => v.to_list(),
    }
}

/// Integrates `y' = f(t, y)` over `span` in `steps` equal steps of
/// `method` (`h = (end - start) / steps`; the span may run backwards).
/// The result has `steps + 1` columns. A NaN or infinity in the state
/// stops the run with `Status::NotFinite`.
///
/// ```nabi
/// use ode::Fixed;
/// use core::array::Vector;
///
/// let y0: Vector<f64> = [1.0];
/// let f = |t: f64, y: Vector<f64>| -> Vector<f64> { y };
/// let e1 = (try ode::fixed(f, 0.0..1.0, y0, 100, method: Fixed::Rk4)).last()[0] - 1.0f64.exp();
/// let e2 = (try ode::fixed(f, 0.0..1.0, y0, 200, method: Fixed::Rk4)).last()[0] - 1.0f64.exp();
/// assert((e1 / e2 - 16.0).abs() < 0.5);   // 4th order: halving h cuts the error 16 times
/// ```
pub fn fixed<Y: AsVector<f64>>(f: fn(f64, Vector<f64>) -> Vector<f64>, span: Range<f64>, y0: Y, steps: usize, method: Fixed = Fixed::Rk4) throws (OdeError) -> Solution {
    let y0: Vector<f64> = y0.as_vector();
    let (t0, t1) = (span.start, span.end);
    if !t0.is_finite() || !t1.is_finite() { throw OdeError::BadArgument { what: f"the span {t0}..{t1} must have finite ends" }; }
    if steps == 0 { throw OdeError::BadArgument { what: "steps must be at least 1; pass the number of equal steps across the span, such as `1000`" }; }
    let n = y0.len();
    let y = y0.to_list();
    for v in y {
        if !v.is_finite() { throw OdeError::NotFinite { what: "y0" }; }
    }
    let h = (t1 - t0) / (steps as f64);
    let nfev = 0usize;
    let ts: List<f64> = [t0];
    let ys: List<List<f64>> = [y];
    let dense = Dense::new(t0, y);
    let k1 = try call(f, t0, y, ref nfev);
    let status = Status::Finished;
    let done = 0usize;
    for i in 0..steps {
        let t = t0 + (i as f64) * h;
        let y_new = match method {
            Fixed::Euler => axpy(y, h, k1),
            Fixed::Midpoint => {
                let k2 = try call(f, t + 0.5 * h, axpy(y, 0.5 * h, k1), ref nfev);
                axpy(y, h, k2)
            },
            Fixed::Heun => {
                let k2 = try call(f, t + h, axpy(y, h, k1), ref nfev);
                let r = axpy(y, 0.5 * h, k1);
                axpy(r, 0.5 * h, k2)
            },
            Fixed::Rk4 => {
                let k2 = try call(f, t + 0.5 * h, axpy(y, 0.5 * h, k1), ref nfev);
                let k3 = try call(f, t + 0.5 * h, axpy(y, 0.5 * h, k2), ref nfev);
                let k4 = try call(f, t + h, axpy(y, h, k3), ref nfev);
                let r = axpy(y, h / 6.0, k1);
                r = axpy(r, h / 3.0, k2);
                r = axpy(r, h / 3.0, k3);
                axpy(r, h / 6.0, k4)
            },
        };
        let t_new = if i + 1 == steps { t1 } else { t0 + ((i + 1) as f64) * h };
        let k_new = try call(f, t_new, y_new, ref nfev);
        // Cubic Hermite through (y, k1) and (y_new, k_new).
        let q = List::filled(3 * n, 0.0);
        for m in 0..n {
            let dy = y_new[m] - y[m];
            q[3 * m] = h * k1[m];
            q[3 * m + 1] = 3.0 * dy - h * (2.0 * k1[m] + k_new[m]);
            q[3 * m + 2] = h * (k1[m] + k_new[m]) - 2.0 * dy;
        }
        dense.push(t_new, Piece::Poly { t0: t, h: h, y0: y, q: q, k: 3 });
        ts.push(t_new);
        ys.push(y_new);
        y = y_new;
        k1 = k_new;
        done += 1;
        let ok = true;
        for v in y {
            if !v.is_finite() { ok = false; }
        }
        if !ok {
            status = Status::NotFinite;
            break;
        }
    }
    let m = ts.len();
    let d = List::filled(n * m, 0.0);
    for j in 0..m {
        for i in 0..n { d[i * m + j] = ys[j][i]; }
    }
    Solution {
        t: Array::from_list(ts, [m]), y: Array::view_list(d, [n, m]), status: status,
        nfev: nfev, njev: 0, nlu: 0, steps: done, sol: dense, t_events: [], y_events: [], switches: [],
    }
}

/// `fixed` with forward Euler.
///
/// ```nabi
/// use core::array::Vector;
///
/// let y0: Vector<f64> = [1.0];
/// let r = try ode::euler(|t: f64, y: Vector<f64>| -> Vector<f64> { y }, 0.0..1.0, y0, 4);
/// assert(r.last()[0] == 1.25 * 1.25 * 1.25 * 1.25);
/// ```
pub fn euler<Y: AsVector<f64>>(f: fn(f64, Vector<f64>) -> Vector<f64>, span: Range<f64>, y0: Y, steps: usize) throws (OdeError) -> Solution {
    let y0: Vector<f64> = y0.as_vector();
    try fixed(f, span, y0, steps, method: Fixed::Euler)
}

/// `fixed` with the classical Runge-Kutta method.
///
/// ```nabi
/// use core::array::Vector;
///
/// let y0: Vector<f64> = [0.0, 1.0];
/// let r = try ode::rk4(|t: f64, y: Vector<f64>| -> Vector<f64> { [y[1], -y[0]] }, 0.0..6.283185307179586, y0, 200);
/// assert((r.last()[1] - 1.0).abs() < 1e-7);
/// ```
pub fn rk4<Y: AsVector<f64>>(f: fn(f64, Vector<f64>) -> Vector<f64>, span: Range<f64>, y0: Y, steps: usize) throws (OdeError) -> Solution {
    let y0: Vector<f64> = y0.as_vector();
    try fixed(f, span, y0, steps, method: Fixed::Rk4)
}
