// Event location: after each step the event functions are compared at
// both ends; a sign change in an allowed direction is refined by Brent's
// method (Brent 1973, `zeroin`) on the step's interpolant, to 4 eps
// relative in t, so a root costs no evaluations of the right-hand side.
// A root at the very start of a step was reported by the step before
// and is not counted again.

use pkg::dense::Piece;
use core::array::{Array, Vector};

/// Which zero crossings of an event function count.
///
/// ```nabi
/// use ode::Direction;
///
/// assert(Direction::Rising != Direction::Falling);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub enum Direction {
    /// Crossings either way.
    Both,
    /// From negative to positive only.
    Rising,
    /// From positive to negative only.
    Falling,
}

/// A function of `(t, y)` whose zeros `solve_ivp` locates. A
/// `terminal` event stops the integration at its first zero.
///
/// ```nabi
/// use ode::{Direction, Event};
/// use core::array::Vector;
///
/// // A ball thrown up at 10 m/s lands after 2 v / g.
/// let ground = Event { f: |t: f64, y: Vector<f64>| -> f64 { y[0] }, terminal: true, direction: Direction::Falling };
/// let y0: Vector<f64> = [0.0, 10.0];
/// let r = try ode::solve_ivp(|t: f64, y: Vector<f64>| -> Vector<f64> { [y[1], -9.81] }, 0.0..5.0, y0, events: [ground]);
/// assert(r.status == ode::Status::Event);
/// assert((r.t_events[0][0] - 20.0 / 9.81).abs() < 1e-10);
/// ```
pub struct Event {
    /// The event function; an event is a zero of it.
    pub f: fn(f64, Vector<f64>) -> f64;
    /// Stop at the first zero.
    pub terminal: bool = false;
    /// Which crossings count.
    pub direction: Direction = Direction::Both;
}

impl Event {
    pub(pkg) fn value(self, t: f64, y: List<f64>) -> f64 { (self.f)(t, Array::view_list(y, [y.len()])) }

    /// Whether `g0 -> g1` is a crossing this event counts.
    pub(pkg) fn crosses(self, g0: f64, g1: f64) -> bool {
        let up = g0 < 0.0 && g1 >= 0.0;
        let down = g0 > 0.0 && g1 <= 0.0;
        match self.direction {
            Direction::Both => up || down,
            Direction::Rising => up,
            Direction::Falling => down,
        }
    }

    /// The zero in `a..b` of the event along the interpolant `p`, given
    /// the values `ga`, `gb` at the ends (opposite signs or `gb == 0`).
    pub(pkg) fn root(self, p: Piece, n: usize, a: f64, b: f64, ga: f64, gb: f64) -> f64 {
        let ev = self;
        let g = |t: f64| -> f64 {
            let v = List::filled(n, 0.0);
            p.eval_into(t, v);
            ev.value(t, v)
        };
        brent(g, a, b, ga, gb)
    }
}

/// Brent's zeroin on `[a, b]` with `fa`, `fb` of opposite signs.
fn brent(f: fn(f64) -> f64, a0: f64, b0: f64, fa0: f64, fb0: f64) -> f64 {
    let (a, b, fa, fb) = (a0, b0, fa0, fb0);
    if fb == 0.0 { return b; }
    if fa == 0.0 { return a; }
    let (c, fc) = (a, fa);
    let d = b - a;
    let e = d;
    for _ in 0..100 {
        if (fb > 0.0) == (fc > 0.0) {
            c = a;
            fc = fa;
            d = b - a;
            e = d;
        }
        if fc.abs() < fb.abs() {
            a = b;
            b = c;
            c = a;
            fa = fb;
            fb = fc;
            fc = fa;
        }
        let tol = 4.0 * f64::EPSILON * b.abs() + 1e-300;
        let m = 0.5 * (c - b);
        if m.abs() <= tol || fb == 0.0 { return b; }
        if e.abs() >= tol && fa.abs() > fb.abs() {
            let s = fb / fa;
            let (p, q) = (0.0, 0.0);
            if a == c {
                p = 2.0 * m * s;
                q = 1.0 - s;
            } else {
                let qa = fa / fc;
                let r = fb / fc;
                p = s * (2.0 * m * qa * (qa - r) - (b - a) * (r - 1.0));
                q = (qa - 1.0) * (r - 1.0) * (s - 1.0);
            }
            if p > 0.0 { q = -q; } else { p = -p; }
            if 2.0 * p < (3.0 * m * q - (tol * q).abs()).min((e * q).abs()) {
                e = d;
                d = p / q;
            } else {
                d = m;
                e = m;
            }
        } else {
            d = m;
            e = m;
        }
        a = b;
        fa = fb;
        b += if d.abs() > tol { d } else if m > 0.0 { tol } else { -tol };
        fb = f(b);
    }
    b
}
