// Variable-order (1 to 5), variable-step backward differentiation
// formulas in the quasi-constant step form of Shampine and Reichelt's
// ode15s (The MATLAB ODE Suite, 1997) with the NDF coefficients kappa,
// which buy accuracy at no loss of stability: the history is a table of
// backward differences D, rescaled whenever the step changes. Each step
// is a simplified Newton solve with the LU of `I - h / alpha J` (at most
// 4 iterations, RADAU5's rate test), the Jacobian refreshed only when
// Newton fails. After `order + 1` equal steps the order moves by one
// where the error estimate of the neighbouring order allows the larger
// step. Following SciPy's `BDF`.

use pkg::OdeError;
use pkg::dense::Piece;
use pkg::ivp::system::{Outcome, Stepper, System, finite, rms_ratio, shifted};
use core::array::Array;
use linalg::Lu;

const MAX_ORDER: usize = 5;
const NEWTON_MAXITER: usize = 4;
const MIN_FACTOR: f64 = 0.2;
const MAX_FACTOR: f64 = 10.0;
const KAPPA: [f64; 6] = [0.0, -0.1850, -1.0 / 9.0, -0.0823, -0.0415, 0.0];

pub(pkg) struct Bdf {
    pub(pkg) t: f64;
    pub(pkg) y: List<f64>;
    pub(pkg) h_abs: f64;
    newton_tol: f64;
    pub(pkg) jac: List<f64>;
    lu: Lu<f64> | none;
    /// Backward differences, `MAX_ORDER + 3` rows of `n`.
    d: List<f64>;
    pub(pkg) order: usize;
    equal_steps: usize;
    gamma: List<f64>;
    alpha: List<f64>;
    error_const: List<f64>;
    t_old: f64;
}

impl Bdf {
    pub(pkg) fn new(ref sys: System, t0: f64, y0: List<f64>, f0: List<f64>, first_step: f64) throws (OdeError) -> Bdf {
        let n = sys.n;
        let h = if first_step > 0.0 { first_step } else { try sys.initial_step(t0, y0, f0, 1.0) };
        let j = try sys.jacobian(t0, y0, f0);
        let gamma = List::filled(MAX_ORDER + 1, 0.0);
        for k in 1..MAX_ORDER + 1 { gamma[k] = gamma[k - 1] + 1.0 / (k as f64); }
        let alpha = List::filled(MAX_ORDER + 1, 0.0);
        let error_const = List::filled(MAX_ORDER + 1, 0.0);
        for k in 0..MAX_ORDER + 1 {
            alpha[k] = (1.0 - KAPPA[k]) * gamma[k];
            error_const[k] = KAPPA[k] * gamma[k] + 1.0 / ((k + 1) as f64);
        }
        let d = List::filled((MAX_ORDER + 3) * n, 0.0);
        for m in 0..n {
            d[m] = y0[m];
            d[n + m] = f0[m] * h * sys.dir;
        }
        Bdf {
            t: t0, y: y0, h_abs: h,
            newton_tol: (10.0 * f64::EPSILON / sys.rtol).max(0.03f64.min(sys.rtol.sqrt())),
            jac: j, lu: none, d: d, order: 1, equal_steps: 0,
            gamma: gamma, alpha: alpha, error_const: error_const, t_old: t0,
        }
    }

    /// A placeholder that has taken no step (for `Auto` before it turns
    /// stiff); costs nothing.
    pub(pkg) fn idle() -> Bdf {
        Bdf {
            t: 0.0, y: [], h_abs: 0.0, newton_tol: 0.0, jac: [], lu: none, d: [], order: 1, equal_steps: 0,
            gamma: [], alpha: [], error_const: [], t_old: 0.0,
        }
    }

    /// The infinity norm of the Jacobian in use, a bound on its
    /// spectral radius.
    pub(pkg) fn jac_norm(self, n: usize) -> f64 {
        let best = 0.0;
        for i in 0..n {
            let s = 0.0;
            for j in 0..n { s += self.jac[i * n + j].abs(); }
            best = best.max(s);
        }
        best
    }

    /// Rescale the differences to a step `factor` times the current.
    fn change_d(ref self, n: usize, factor: f64) {
        let order = self.order;
        let r = compute_r(order, factor);
        let u = compute_r(order, 1.0);
        let k = order + 1;
        // RU = R U; D[:k] = RU^T D[:k].
        let ru = List::filled(k * k, 0.0);
        for i in 0..k {
            for j in 0..k {
                let acc = 0.0;
                for l in 0..k { acc += r[i * k + l] * u[l * k + j]; }
                ru[i * k + j] = acc;
            }
        }
        let nd = List::filled(k * n, 0.0);
        for i in 0..k {
            for l in 0..k {
                let c = ru[l * k + i];
                if c == 0.0 { continue; }
                for m in 0..n { nd[i * n + m] += c * self.d[l * n + m]; }
            }
        }
        for i in 0..k * n { self.d[i] = nd[i]; }
    }

    pub(pkg) fn step(ref self, ref sys: System) throws (OdeError) -> Outcome {
        let n = sys.n;
        let t = self.t;
        let min_step = sys.min_step(t);
        let h_abs = self.h_abs;
        if self.h_abs > sys.max_step {
            h_abs = sys.max_step;
            let r = sys.max_step / self.h_abs;
            self.change_d(n, r);
            self.equal_steps = 0;
        } else if self.h_abs < min_step {
            h_abs = min_step;
            let r = min_step / self.h_abs;
            self.change_d(n, r);
            self.equal_steps = 0;
        }
        let order = self.order;
        let j = self.jac;
        let lu = self.lu;
        let current_jac = sys.constant_jac();
        let nan = false;
        let t_new = t;
        let y_new: List<f64> = [];
        let dd: List<f64> = [];
        let safety = 0.0;
        let en = 0.0;
        let scale: List<f64> = [];
        loop {
            if h_abs < min_step { return if nan { Outcome::NotFinite } else { Outcome::TooSmall }; }
            t_new = t + h_abs * sys.dir;
            if sys.dir * (t_new - sys.t_bound) > 0.0 {
                t_new = sys.t_bound;
                self.change_d(n, (t_new - t).abs() / h_abs);
                self.equal_steps = 0;
                lu = none;
            }
            let h = t_new - t;
            h_abs = h.abs();
            let y_pred = List::filled(n, 0.0);
            for i in 0..order + 1 {
                for m in 0..n { y_pred[m] += self.d[i * n + m]; }
            }
            scale = sys.scale(y_pred);
            let psi = List::filled(n, 0.0);
            for i in 1..order + 1 {
                let g = self.gamma[i] / self.alpha[order];
                for m in 0..n { psi[m] += g * self.d[i * n + m]; }
            }
            let c = h / self.alpha[order];
            let converged = false;
            let iters = 0usize;
            loop {
                let a = match lu {
                    a: Lu<f64> => a,
                    none => {
                        sys.nlu += 1;
                        try linalg::lu(shifted(j, n, 1.0, c)) catch _ { break; }
                    },
                };
                lu = a;
                // Simplified Newton on y = y_pred + d.
                let yk = y_pred.clone();
                let d = List::filled(n, 0.0);
                let norm_old = -1.0;
                let k = 0usize;
                let ok = false;
                while k < NEWTON_MAXITER {
                    let fk = try sys.eval(t_new, yk);
                    if !finite(fk) { nan = true; break; }
                    let rhs = List::filled(n, 0.0);
                    for m in 0..n { rhs[m] = c * fk[m] - psi[m] - d[m]; }
                    let dy = try a.solve(Array::view_list(rhs, [n])) catch _ { break; };
                    let dl = List::filled(n, 0.0);
                    for m in 0..n { dl[m] = dy[m]; }
                    let dnorm = rms_ratio(dl, scale);
                    let rate = if norm_old < 0.0 { -1.0 } else { dnorm / norm_old };
                    if rate >= 0.0 && (rate >= 1.0 || rate.powi((NEWTON_MAXITER - k) as i32) / (1.0 - rate) * dnorm > self.newton_tol) {
                        k += 1;
                        break;
                    }
                    let yn = yk.clone();
                    for m in 0..n {
                        yn[m] += dl[m];
                        d[m] += dl[m];
                    }
                    yk = yn;
                    k += 1;
                    if dnorm == 0.0 || (rate >= 0.0 && rate / (1.0 - rate) * dnorm < self.newton_tol) {
                        ok = true;
                        break;
                    }
                    norm_old = dnorm;
                }
                iters = k.max(1);
                if ok {
                    converged = true;
                    y_new = yk;
                    dd = d;
                    break;
                }
                if current_jac { break; }
                let fp = try sys.eval(t_new, y_pred);
                j = try sys.jacobian(t_new, y_pred, fp);
                lu = none;
                current_jac = true;
            }
            if !converged {
                h_abs *= 0.5;
                self.change_d(n, 0.5);
                self.equal_steps = 0;
                lu = none;
                continue;
            }
            nan = false;
            safety = 0.9 * ((2 * NEWTON_MAXITER + 1) as f64) / ((2 * NEWTON_MAXITER + iters) as f64);
            scale = sys.scale(y_new);
            let ec = self.error_const[order];
            let err = List::filled(n, 0.0);
            for m in 0..n { err[m] = ec * dd[m]; }
            en = rms_ratio(err, scale);
            if en > 1.0 {
                let factor = MIN_FACTOR.max(safety * en.pow(-1.0 / ((order + 1) as f64)));
                h_abs *= factor;
                self.change_d(n, factor);
                self.equal_steps = 0;
                continue;
            }
            break;
        }
        self.equal_steps += 1;
        self.t_old = t;
        self.t = t_new;
        self.y = y_new;
        self.h_abs = h_abs;
        self.jac = j;
        self.lu = lu;
        // D^{j+1} y_n = D^j y_n - D^j y_{n-1}.
        for m in 0..n {
            self.d[(order + 2) * n + m] = dd[m] - self.d[(order + 1) * n + m];
            self.d[(order + 1) * n + m] = dd[m];
        }
        let i = order + 1;
        while i > 0 {
            i -= 1;
            for m in 0..n { self.d[i * n + m] += self.d[(i + 1) * n + m]; }
        }
        if self.equal_steps < order + 1 { return Outcome::Accepted; }
        let em = f64::INFINITY;
        let ep = f64::INFINITY;
        let tmp = List::filled(n, 0.0);
        if order > 1 {
            let c = self.error_const[order - 1];
            for m in 0..n { tmp[m] = c * self.d[order * n + m]; }
            em = rms_ratio(tmp, scale);
        }
        if order < MAX_ORDER {
            let c = self.error_const[order + 1];
            for m in 0..n { tmp[m] = c * self.d[(order + 2) * n + m]; }
            ep = rms_ratio(tmp, scale);
        }
        let norms = [em, en, ep];
        let best = 0usize;
        let best_f = -1.0;
        for k in 0..3 {
            // A zero error allows any step.
            let fk = if norms[k] == 0.0 { f64::INFINITY } else { norms[k].pow(-1.0 / ((order + k) as f64)) };
            if fk > best_f {
                best_f = fk;
                best = k;
            }
        }
        self.order = order + best - 1;
        let factor = MAX_FACTOR.min(safety * best_f);
        self.h_abs *= factor;
        self.change_d(n, factor);
        self.equal_steps = 0;
        self.lu = none;
        Outcome::Accepted
    }

    /// The interpolant of the last step: the current difference table,
    /// rescaled to the next step size, still passes through it.
    pub(pkg) fn piece(self, ref sys: System) -> Piece {
        let n = sys.n;
        let k = self.order + 1;
        let d = List::filled(k * n, 0.0);
        for i in 0..k * n { d[i] = self.d[i]; }
        Piece::Bdf { t: self.t, h: self.h_abs * sys.dir, order: self.order, d: d }
    }
}

/// ode15s's R: `(order + 1)^2`, the difference table change for a step
/// ratio `factor`.
fn compute_r(order: usize, factor: f64) -> List<f64> {
    let k = order + 1;
    let m = List::filled(k * k, 0.0);
    for j in 0..k { m[j] = 1.0; }
    for i in 1..k {
        for j in 1..k { m[i * k + j] = ((i as f64) - 1.0 - factor * (j as f64)) / (i as f64); }
    }
    for i in 1..k {
        for j in 0..k { m[i * k + j] *= m[(i - 1) * k + j]; }
    }
    m
}

impl Stepper for Bdf {
    fn time(self) -> f64 { self.t }
    fn state(self) -> List<f64> { self.y }
    fn advance(ref self, ref sys: System) throws (OdeError) -> Outcome { try self.step(ref sys) }
    fn interpolant(ref self, ref sys: System) throws (OdeError) -> Piece { self.piece(ref sys) }
}
