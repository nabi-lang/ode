// Initial value problems: one full solve per iteration.

use pkg::{Jacobian, Method};
use core::bench::Bench;

#[bench]
fn lorenz_rk45(b: Bench) {
    let p = pkg::problems::lorenz();
    b.iter(|| try! pkg::solve_ivp(p.f, 0.0..100.0, p.y0, rtol: 1e-6, atol: 1e-9, dense: false));
}

#[bench]
fn lorenz_dop853(b: Bench) {
    let p = pkg::problems::lorenz();
    b.iter(|| try! pkg::solve_ivp(p.f, 0.0..100.0, p.y0, method: Method::Dop853, rtol: 1e-10, atol: 1e-12, dense: false));
}

#[bench]
fn van_der_pol_radau(b: Bench) {
    let p = pkg::problems::van_der_pol(1000.0);
    b.iter(|| try! pkg::solve_ivp(p.f, p.span, p.y0, method: Method::Radau, rtol: 1e-6, atol: 1e-6, jac: Jacobian::Exact(p.jac), dense: false));
}

#[bench]
fn van_der_pol_bdf(b: Bench) {
    let p = pkg::problems::van_der_pol(1000.0);
    b.iter(|| try! pkg::solve_ivp(p.f, p.span, p.y0, method: Method::Bdf, rtol: 1e-6, atol: 1e-6, jac: Jacobian::Exact(p.jac), dense: false));
}

#[bench]
fn van_der_pol_auto(b: Bench) {
    let p = pkg::problems::van_der_pol(1000.0);
    b.iter(|| try! pkg::solve_ivp(p.f, p.span, p.y0, method: Method::Auto, rtol: 1e-6, atol: 1e-6, dense: false));
}

#[bench]
fn robertson_bdf(b: Bench) {
    let p = pkg::problems::robertson();
    b.iter(|| try! pkg::solve_ivp(p.f, p.span, p.y0, method: Method::Bdf, rtol: 1e-8, atol: [1e-10, 1e-14, 1e-10], jac: Jacobian::Exact(p.jac), dense: false));
}

#[bench]
fn hires_rodas(b: Bench) {
    let p = pkg::problems::hires();
    b.iter(|| try! pkg::solve_ivp(p.f, p.span, p.y0, method: Method::Rodas, rtol: 1e-8, atol: 1e-10, jac: Jacobian::Exact(p.jac), dense: false));
}
